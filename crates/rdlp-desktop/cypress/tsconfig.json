{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM"],
        "module": "CommonJS",
        "moduleResolution": "node",
        "strict": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "skipLibCheck": true,
        "types": ["cypress"]
    },
    "include": ["./**/*.ts"]
}
