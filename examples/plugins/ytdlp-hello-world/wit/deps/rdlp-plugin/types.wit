package rdlp:plugin@0.5.2;

interface types {
    record plugin-info {
        name: string,
        version: string,
        wit-version: string,
        matches: list<string>,
        url-regex: option<string>,
        priority: u8,
        claims-override: list<string>,
        supports-search: bool,
    }

    record format {
        format-id: string,
        url: string,
        ext: string,
        protocol: string,
        width: option<u32>,
        height: option<u32>,
        fps: option<f32>,
        tbr: option<f32>,
        vbr: option<f32>,
        abr: option<f32>,
        vcodec: option<string>,
        acodec: option<string>,
        container: option<string>,
        filesize: option<u64>,
        format-note: option<string>,
    }

    record subtitle-track {
        language: string,
        kind: string,
        url: string,
        ext: string,
    }

    record info-dict {
        id: string,
        title: string,
        url: option<string>,
        formats: list<format>,
        subtitles: list<subtitle-track>,
        thumbnail: option<string>,
        description: option<string>,
        uploader: option<string>,
        uploader-id: option<string>,
        upload-date: option<string>,
        duration: option<u32>,
        view-count: option<u64>,
        like-count: option<u64>,
        tags: list<string>,
        categories: list<string>,
    }

    record search-query {
        query: string,
        page: option<u32>,
        filters: list<tuple<string, string>>,
    }

    record search-result {
        url: string,
        title: string,
        thumbnail: option<string>,
        duration: option<u32>,
        uploader: option<string>,
    }

    record search-page {
        results: list<search-result>,
        page: u32,
        has-more: bool,
        total-estimate: option<u64>,
    }

    /// Mirrors rdlp_types::SearchFilterDescriptor; allowed-values carries the
    /// values only (labels are host-rendered as the value).
    @since(version = 0.5.1)
    record search-filter-descriptor {
        key: string,
        display-name: string,
        allowed-values: list<string>,
        default: option<string>,
    }

    /// One item of a playlist listing. The host resolves it through this
    /// plugin's `extract`; the plugin never resolves items itself
    /// (yt-dlp `url_result`, gallery-dl `Message.Queue`, Grayjay `Pager`).
    @since(version = 0.5.2)
    record playlist-entry {
        url: string,
        id: option<string>,
        title: option<string>,
    }

    /// One page of a playlist listing. `page` is 1-indexed, like
    /// `search-page`; `has-more` ends the host's page loop.
    @since(version = 0.5.2)
    record playlist-page {
        entries: list<playlist-entry>,
        page: u32,
        has-more: bool,
        playlist-id: option<string>,
        playlist-title: option<string>,
        total-estimate: option<u64>,
    }

    /// Same vocabulary as `search-error`, minus `unsupported` (an absent
    /// export already means "no playlist support") and `cancelled` (the
    /// host cancels the whole call).
    @since(version = 0.5.2)
    variant playlist-error {
        unsupported-url(string),
        not-found(string),
        rate-limited(option<u32>),
        network(string),
        parse(string),
        internal(string),
    }

    /// Mirrors rdlp's native `Thumbnail`.
    @since(version = 0.5.2)
    record thumbnail {
        url: string,
        id: option<string>,
        width: option<u32>,
        height: option<u32>,
        preference: option<s32>,
    }

    /// A typed open-metadata value: OpenTelemetry's stable attribute
    /// subset (scalar + homogeneous list), never a nested map.
    @since(version = 0.5.2)
    variant meta-value {
        text(string),
        integer(s64),
        number(f64),
        flag(bool),
        text-list(list<string>),
    }

    /// Metadata `info-dict` (frozen at 0.5.0) cannot carry. The named
    /// fields recur across most sites; `extras` is the open tail, validated
    /// and capped by the host before it reaches `InfoDict::extra`.
    @since(version = 0.5.2)
    record info-dict-extra {
        actors: list<string>,
        channel: option<string>,
        channel-url: option<string>,
        age-limit: option<u8>,
        thumbnails: list<thumbnail>,
        extras: list<tuple<string, meta-value>>,
    }

    /// What `extract-with-metadata` returns: the frozen core plus the extra.
    @since(version = 0.5.2)
    record extraction {
        core: info-dict,
        extra: info-dict-extra,
    }

    variant extract-error {
        unsupported-url(string),
        not-found(string),
        rate-limited(option<u32>),
        auth-required(string),
        network(string),
        parse(string),
        cancelled,
        internal(string),
    }

    variant search-error {
        unsupported,
        rate-limited(option<u32>),
        network(string),
        parse(string),
        cancelled,
        internal(string),
    }
}
