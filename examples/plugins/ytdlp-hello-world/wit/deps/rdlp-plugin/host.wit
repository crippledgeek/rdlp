package rdlp:plugin@0.5.0;

interface host-fetch {
    record request {
        url: string,
        method: string,
        headers: list<tuple<string, string>>,
        body: option<list<u8>>,
        timeout-ms: option<u32>,
    }

    record response {
        status: u16,
        headers: list<tuple<string, string>>,
        body: list<u8>,
        final-url: string,
    }

    variant fetch-error {
        timeout,
        cancelled,
        network(string),
        too-many-redirects,
        body-too-large,
    }

    fetch: func(req: request) -> result<response, fetch-error>;
}

interface host-cookie-jar {
    record cookie {
        name: string,
        value: string,
        domain: string,
        path: string,
        secure: bool,
        http-only: bool,
        expires: option<u64>,
    }

    get-cookies: func(url: string) -> list<cookie>;
    set-cookie: func(url: string, cookie: cookie) -> result<_, string>;
}

interface host-js-eval {
    record context {
        source-url: string,
        sandbox-globals: list<tuple<string, string>>,
    }

    eval: func(ctx: context, source: string) -> result<string, string>;
}

interface host-html-select {
    select: func(html: string, css-selector: string) -> list<string>;
    select-attr: func(html: string, css-selector: string, attr: string) -> list<string>;
}

interface host-log {
    enum level {
        trace,
        debug,
        info,
        warn,
        error,
    }

    log: func(level: level, message: string);
}

interface host-store-kv {
    get: func(key: string) -> option<list<u8>>;
    set: func(key: string, value: list<u8>) -> result<_, string>;
    delete: func(key: string);
}

interface host-extract-helpers {
    use host-fetch.{fetch-error};

    flags regex-flags {
        ignore-case,
        multiline,
        dotall,
        verbose,
    }

    record m3u8-format {
        format-id: string,
        url: string,
        ext: string,
        protocol: string,
        tbr: option<f32>,
        width: option<u32>,
        height: option<u32>,
        fps: option<f32>,
        vcodec: option<string>,
        acodec: option<string>,
        vbr: option<f32>,
        abr: option<f32>,
        language: option<string>,
        format-note: option<string>,
        format-index: option<u32>,
        manifest-url: option<string>,
        has-drm: option<bool>,
        preference: option<s32>,
        quality: option<f32>,
    }

    record extract-helpers-subtitle {
        language: string,
        url: string,
        ext: option<string>,
    }

    /// Caller-supplied HTTP options threaded into the underlying fetch.
    /// `headers` and `query` are key-value lists — duplicate keys are
    /// preserved verbatim. `body`, when present, switches the method to POST.
    record fetch-options {
        headers: list<tuple<string, string>>,
        query: list<tuple<string, string>>,
        body: option<list<u8>>,
    }

    record m3u8-extraction {
        formats: list<m3u8-format>,
        subtitles: list<extract-helpers-subtitle>,
    }

    record m3u8-options {
        ext: option<string>,
        protocol: option<string>,
        m3u8-id: option<string>,
        fatal: bool,
    }

    record json-ld-video {
        title: option<string>,
        description: option<string>,
        thumbnail: option<string>,
        thumbnails: list<string>,
        upload-date: option<string>,
        duration: option<u32>,
        view-count: option<u64>,
        like-count: option<u64>,
        tags: list<string>,
        categories: list<string>,
    }

    search-regex: func(pattern: string, haystack: string, re-flags: regex-flags)
                    -> option<string>;

    /// Search `haystack` and return the first capture group, tags stripped.
    ///
    /// The result is returned VERBATIM — HTML entities are NOT decoded. The
    /// host decodes display text exactly once, when the `info-dict` a plugin
    /// returns crosses the boundary, so decoding here as well would be two
    /// single-pass decodes composing into one double decode (a literal
    /// `&amp;lt;` would become `<`).
    ///
    /// A value destined for `info-dict.url`, `.thumbnail`, or a
    /// `subtitle-track.url` is not left to you either: the host runs a
    /// narrower repair on those, undoing `&amp;` and only `&amp;`, because in
    /// a URL `&` is a query separator and a full decoder would invent
    /// structure (`&sol;` to `/`). See `og-search-property` for why a
    /// `format`'s `url` is deliberately not among them.
    html-search-regex: func(pattern: string, haystack: string, re-flags: regex-flags)
                    -> option<string>;

    html-search-meta: func(name: string, html: string) -> option<string>;

    /// Return the `content` of the `og:<prop>` meta tag.
    ///
    /// VERBATIM — entities are not decoded; see `html-search-regex` for why,
    /// and for what a plugin must do when the property is a URL. `og:image`
    /// is the common case: an `&` inside an HTML attribute is serialized
    /// `&amp;`, so the raw value carries it. For the fields of `info-dict`
    /// that this plugin can set and that end up as metadata URLs — `url`
    /// (which the host stores as `webpage_url`), `thumbnail`, and each
    /// `subtitle-track`'s `url` — you do not need to undo it: the host repairs
    /// that one entity there (`rdlp_types::repair_url_entities`), at the same
    /// boundary that decodes display text.
    ///
    /// A `format`'s own `url` is NOT repaired: those come from manifests and
    /// APIs with their own escaping rules, so a blanket repair would double up
    /// on a producer that already decoded — `dash_mpd` decodes an MPD's
    /// entities before rdlp ever sees the URL. If you build a format URL out
    /// of HTML yourself, undo `&amp;` yourself.
    og-search-property: func(prop: string, html: string) -> option<string>;

    rta-search: func(html: string) -> option<u8>;

    search-json: func(start-pattern: string, end-pattern: string,
                      haystack: string) -> option<string>;

    extract-m3u8: func(
        url: string,
        video-id: string,
        opts: m3u8-options,
        fetch: fetch-options,
    ) -> result<m3u8-extraction, fetch-error>;

    extract-json-ld: func(html: string) -> option<json-ld-video>;

    record mpd-options {
        mpd-id: option<string>,
        fatal: bool,
    }

    record mpd-fragment {
        url: string,
        duration: option<f64>,
        /// Subrange of `url` to fetch via HTTP `Range:` header.
        /// `(start, end_exclusive)`. Matches `rdlp_types::Fragment.byte_range`.
        /// When set, plugins receive DASH ranged media segments (SegmentList /
        /// SegmentBase with `@mediaRange`).
        byte-range: option<tuple<u64, u64>>,
        /// `<Initialization>` segment URI for THIS fragment. Per-fragment so
        /// multi-init streams work correctly. When `none`, plugins fall back
        /// to the format-level fragment-base-url (yt-dlp `initialization_url`
        /// convention).
        init-url: option<string>,
        /// Subrange of `init-url`. Same `(start, end_exclusive)` convention
        /// as `byte-range`.
        init-byte-range: option<tuple<u64, u64>>,
    }

    record mpd-format {
        format-id: string,
        url: string,
        ext: string,
        vcodec: option<string>,
        acodec: option<string>,
        tbr: option<f32>,
        width: option<u32>,
        height: option<u32>,
        fps: option<f32>,
        asr: option<u32>,
        language: option<string>,
        container: option<string>,
        manifest-url: option<string>,
        fragment-base-url: option<string>,
        fragments: list<mpd-fragment>,
    }

    record mpd-extraction {
        formats: list<mpd-format>,
        subtitles: list<extract-helpers-subtitle>,
    }

    extract-mpd: func(
        url: string,
        video-id: string,
        opts: mpd-options,
        fetch: fetch-options,
    ) -> result<mpd-extraction, fetch-error>;
}
