# Node.js / Frontend
node_modules/
crates/rdlp-desktop/dist/

# pnpm is this project's package manager (see BUILDING.md). `pnpm-lock.yaml` IS
# committed — npm and pnpm both state the lockfile belongs in source control so
# installs are reproducible across machines, CI, and releases. These entries
# exist to keep foreign package-manager artifacts OUT, not to exclude lockfiles.
package-lock.json
yarn.lock
bun.lockb
bun.lock

# Un-ignore TypeScript files in desktop frontend (*.ts above targets MPEG-TS video)
!crates/rdlp-desktop/**/*.ts
!crates/rdlp-desktop/**/*.tsx

# superpowers brainstorm + plan scratch
.superpowers/

# graphify knowledge graph output (per-machine artifact)
graphify-out/
.graphifyignore

# cargo-mutants writes its report tree into the repo root; regenerated on every
# run. Note it also copies the whole worktree to $TMPDIR — point that at real
# disk, because /tmp here is a RAM-backed tmpfs and the copy includes the
# nested target/ under examples/plugins/.
mutants.out/
mutants.out.old/

# Tauri codegen output. `tauri-build` regenerates this on every build, and it
# differs per host OS — a Linux build never refreshes windows-schema.json, so a
# tracked copy silently rots (it had already drifted from the dependency set
# alongside it). Upstream's own `tauri init` gitignores the whole `gen` folder
# for exactly this reason. The files still exist locally, so the `$schema`
# reference in capabilities/default.json keeps resolving for IDE completion.
crates/rdlp-desktop/src-tauri/gen/
